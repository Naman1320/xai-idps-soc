{
  "folders": [
    {
      "name": "XAI-IDPS-SOC (Full Platform)",
      "path": "."
    },
    {
      "name": "SOC Backend (FastAPI)",
      "path": "soc-backend"
    },
    {
      "name": "SOC Dashboard (React)",
      "path": "soc-dashboard"
    },
    {
      "name": "ML Detection & XAI Pipeline",
      "path": "detection"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "/Library/Frameworks/Python.framework/Versions/3.12/bin/python3",
    "python.analysis.extraPaths": [
      "${workspaceFolder:SOC Backend (FastAPI)}",
      "${workspaceFolder:XAI-IDPS-SOC (Full Platform)}/soc-backend",
      "${workspaceFolder:XAI-IDPS-SOC (Full Platform)}"
    ],
    "editor.formatOnSave": true,
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.tabSize": 4,
      "editor.insertSpaces": true
    },
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.tabSize": 2
    },
    "[javascriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.tabSize": 2
    }
  }
