# === SOC Backend Configuration ===
# Database
DATABASE_URL=sqlite:///./soc.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/xai_idps_soc

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# API Key for detection pipeline -> backend ingestion
INGESTION_API_KEY=change-this-to-a-random-api-key

# Server
SOC_BACKEND_HOST=0.0.0.0
SOC_BACKEND_PORT=8000

# === Detection Pipeline Configuration ===
# SOC Backend URL for alert forwarding
SOC_BACKEND_URL=http://localhost:8000/api/v1

# Rate limiting
ALERT_RATE_LIMIT_PER_MINUTE=1000

# === Geolocation & Threat Intelligence (Optional) ===
# MaxMind GeoLite2 (City + ASN)
# Free account signup: https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=your-maxmind-license-key-here
GEOLITE2_CITY_DB=detection/data/geolite2/GeoLite2-City.mmdb
GEOLITE2_ASN_DB=detection/data/geolite2/GeoLite2-ASN.mmdb

# AbuseIPDB (Threat Intelligence Reputation, 1,000 checks/day free tier)
# Free tier signup: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your-abuseipdb-api-key-here
